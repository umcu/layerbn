# ---------------------------
# Python research .gitignore
# ---------------------------

# --- Data (never track raw/sensitive data) ---
data/
Data/
datasets/
*.csv
*.tsv
*.xlsx
*.xls
*.sav
*.dta
*.RData
*.feather
*.parquet
*.h5
*.mat
*.npy
*.npz
*.RDS

# --- Manuscripts / Documents (not tracked) ---
*.doc
*.docx
*.pdf
*.rtf
*.tex
*.odt
*.ppt
*.pptx
*.key
*.numbers
*.pages
# --- Research artifacts (figures, network files, presentations, archives) ---
# Ignored by file type rather than by folder so directories stay walkable
# (this lets .gitkeep files preserve the folder scaffolding in a clone).
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.svg
*.eps
*.zip
*.sif
*.cys
*.gml

# Keep folder scaffolding discoverable
!**/.gitkeep

# Keep the repo logo (referenced in README). *.png above is a blanket
# ignore, so a new logo file is invisible to git until it is listed here.
!logo-vci-bayes.png

# --- Python cache / bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / distribution ---
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST
wheels/
share/python-wheels/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/
.venv-mac/
.venv-win/

# --- Local configs ---
# Real machine-specific paths must never enter the repository. Each project
# ships a `config.example.yml` (tracked, placeholders only); copy that to
# `config.yml` (ignored) and fill in your own paths there.
config/*.local.yml
projects/*/config.yml
!**/config.example.yml

# --- Jupyter / IPython ---
.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- Logs / temp files ---
*.log
*.out
*.tmp
*.bak
*.swp
.coverage
.coverage.*
.cache
.pytest_cache/

# --- Test / coverage reports ---
htmlcov/
.tox/
.nox/
*.cover
*.py.cover
nosetests.xml
coverage.xml
.hypothesis/
cover/

# --- Editors / IDEs ---
.vscode/
.idea/
*.iml
.spyproject
.ropeproject
.pyre/
.pytype/
.mypy_cache/
.ruff_cache/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Office / Word scratch & lock files ---
~$*
*.sb-*

# --- R session junk ---
.Rhistory
.RData
.Rproj.user/
*.vdoc.*

# --- Docs build outputs ---
docs/_build/
site/
config/data_paths.yml
.env

# Internal working documents
MIGRATION.md
PORT_DIFF.md
SPEC_PLAN.md
